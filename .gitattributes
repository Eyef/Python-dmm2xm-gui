# https://docs.github.com/en/get-started/git-basics/configuring-git-to-handle-line-endings#example

# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto
*.sh text eol=lf

# Declare files that will always have CRLF line endings on checkout.
/sources/** text eol=crlf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.ico binary

# Specific settings not applicable with global wildcards.
/readme.txt working-tree-encoding=WINDOWS-1251 encoding=WINDOWS-1251
/*.bat working-tree-encoding=WINDOWS-1251 encoding=WINDOWS-1251
/conv_wad_wine.bat working-tree-encoding=IBM866 encoding=IBM866
